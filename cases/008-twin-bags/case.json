    {"id": "m35", "app": "messenger", "thread": "t4", "from": "p1", "at": "2026-12-05T17:12", "text": "나도 모르겠어 미치겠다"},
    {"id": "m36", "app": "messenger", "thread": "t4", "from": "p7", "at": "2026-12-05T17:13", "text": "너 진짜 아니지?"},
